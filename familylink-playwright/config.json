{
  "name": "Google Family Link Auth",
  "version": "2.0.0",
  "slug": "familylink-playwright",
  "description": "Authentication service for Google Family Link integration using browser automation",
  "url": "https://github.com/noiwid/HAFamilyLink",
  "image": "ghcr.io/noiwid/familylink-auth",
  "arch": ["amd64", "aarch64"],
  "startup": "application",
  "boot": "auto",
  "init": false,
  "ingress": true,
  "ingress_port": 8099,
  "panel_icon": "mdi:account-child-circle",
  "panel_title": "Family Link Auth",
  "ports": {
    "8099/tcp": null
  },
  "ports_description": {
    "8099/tcp": "Web interface, REST API and browser view. Left unmapped on purpose: the add-on is reached through Home Assistant ingress, which authenticates you first. Only map a host port if the Home Assistant integration runs on another machine, and then give it the service API token."
  },
  "map": ["share:rw"],
  "options": {
    "log_level": "info",
    "auth_timeout": 300,
    "session_duration": 86400,
    "language": "",
    "timezone": "",
    "cookie_allowlist_mode": "strict"
  },
  "schema": {
    "log_level": "list(trace|debug|info|warning|error)?",
    "auth_timeout": "int(60,600)?",
    "session_duration": "int(3600,604800)?",
    "language": "str?",
    "timezone": "str?",
    "cookie_allowlist_mode": "list(strict|legacy)?",
    "vnc_password": "password?"
  },
  "host_network": false,
  "hassio_api": true,
  "hassio_role": "default"
}
